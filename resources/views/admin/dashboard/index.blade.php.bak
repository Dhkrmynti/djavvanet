@push('scripts')
<script>
    $(document).ready(function() {
        const table = $('#mikrotik-table').DataTable({
            processing: true,
            serverSide: false,
            ajax: '{{ route("admin.dashboard.mikrotik_data") }}',
            columns: [
                { data: null, render: (d, t, r, meta) => meta.row + 1, className: 'text-center font-mono text-[var(--text-muted)]' },
                { data: 'name', className: 'font-bold text-[var(--text-main)]' },
                { data: 'profile', className: '', render: d => `<span class="bg-[var(--bg-page)] text-[var(--text-muted)] px-2 py-0.5 rounded-sm border border-[var(--border-main)] font-mono text-[9px]">${d}</span>` },
                { data: 'status', orderable: false, className: '' },
                { data: 'online', orderable: false, className: 'text-center' },
                { data: 'action', orderable: false, className: 'text-center' }
            ],
            dom: 'rtp',
            paging: true,
            pageLength: 50,
            ordering: true,
            info: false,
            language: {
                zeroRecords: "Tidak ada data",
                paginate: {
                    previous: "Prev",
                    next: "Next"
                }
            },
            createdRow: function(row, data, dataIndex) {
                 $(row).addClass('hover:bg-[var(--nav-hover)] transition-colors group');
            }
        });

        $('#mikrotik-search').on('keyup', function() {
            table.search(this.value).draw();
        });

        $('#mikrotik-length').on('change', function() {
            table.page.len(this.value).draw();
        });

        window.filterPelanggan = function(val) {
        table.search(val).draw();
      };
    });

    function toggleActionMenu(btn) {
      const dropdown = $(btn).next('.action-dropdown');
      const isShowing = dropdown.hasClass('show');
      $('.action-dropdown.show').removeClass('show');
      if (!isShowing) dropdown.addClass('show');
      if(window.event) window.event.stopPropagation();
    }
 
    $(document).on('click', () => {
      $('.action-dropdown.show').removeClass('show');
    });

    function disconnectUser(name) {
      if(!confirm(`Putus sesi ${name}?`)) return;
      $.post('{{ route("admin.settings.mikrotik.disconnect") }}', { _token: '{{ csrf_token() }}', username: name })
       .done(res => { alert(res.message || 'Sesi diputuskan'); $('#mikrotik-table').DataTable().ajax.reload(); })
       .fail(err => alert('Gagal: ' + (err.responseJSON?.error || 'Unknown error')));
    }

    function toggleUser(name, action) {
      if(!confirm(`${action === 'enable' ? 'Aktifkan' : 'Nonaktifkan'} user ${name}?`)) return;
      $.post('{{ route("admin.settings.mikrotik.toggle") }}', { _token: '{{ csrf_token() }}', username: name, action: action })
       .done(res => { alert(res.message || 'Status diperbarui'); $('#mikrotik-table').DataTable().ajax.reload(); })
       .fail(err => alert('Gagal: ' + (err.responseJSON?.error || 'Unknown error')));
    }

    function isolirUser(name) {
      if(!confirm(`Isolir user ${name}?`)) return;
      $.post('{{ route("admin.settings.mikrotik.isolir") }}', { _token: '{{ csrf_token() }}', username: name })
       .done(res => { alert(res.message || 'User diisolir'); $('#mikrotik-table').DataTable().ajax.reload(); })
       .fail(err => alert('Gagal: ' + (err.responseJSON?.error || 'Unknown error')));
    }

    function restoreUser(name) {
      if(!confirm(`Buka isolir user ${name}?`)) return;
      $.post('{{ route("admin.settings.mikrotik.restore") }}', { _token: '{{ csrf_token() }}', username: name })
       .done(res => { alert(res.message || 'Isolir dibuka'); $('#mikrotik-table').DataTable().ajax.reload(); })
       .fail(err => alert('Gagal: ' + (err.responseJSON?.error || 'Unknown error')));
    }

    function openInvoiceDetail(tr) {
      if(!tr || !tr.dataset.json) return;
      try {
        const data = JSON.parse(tr.dataset.json);
        const customer = data.customer || {};
        const package = customer.package || {};

        $('#det-inv-number-title').text(data.invoice_number);
        $('#det-inv-number').text(data.invoice_number);
        $('#det-customer-name').text(customer.full_name || 'N/A');
        $('#det-customer-code').text(customer.customer_code || 'N/A');
        
        let pStart = data.period_start ? new Date(data.period_start) : new Date();
        $('#det-period').text(pStart.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }));
        
        let dDate = data.due_date ? new Date(data.due_date) : null;
        $('#det-due-date').text(dDate ? dDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-');
        
        $('#det-package').text(`${package.name || '-'} (${customer.username || '-'})`);
        $('#det-whatsapp').text(customer.whatsapp_number || '-');
        $('#det-total-amount').text('Rp ' + parseInt(data.total_amount).toLocaleString('id-ID'));
        $('#det-address').text(customer.address || '-');

        const statusContainer = $('#det-status');
        if (data.status === 'paid') {
           statusContainer.html('<span class="badge-up">Sudah Bayar</span>');
        } else {
           statusContainer.html('<span class="badge-warn">Belum Bayar</span>');
        }

        $('body').addClass('detail-open');
      } catch(e) {
        console.error('JSON Parse Error', e);
      }
    }

    function closeInvoiceDetail() {
      $('body').removeClass('detail-open');
    }
</script>
@endpush